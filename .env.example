# Binance API (public data only, no key needed for market data)
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_REST_BASE=https://api.binance.com

# Server
PORT=3000

# Alert thresholds (customize these)
HOLE_COLLAPSE_THRESHOLD=2000      # Hole collapse events/day to trigger alert
BETTI_JUMP_THRESHOLD=120          # Betti jump events/day
MAX_PERSISTENCE_THRESHOLD=180     # Max persistence strength

# Manipulation index alert level
MANIPULATION_EXTREME_THRESHOLD=55
MANIPULATION_HIGH_THRESHOLD=40

# Push notification (optional - Telegram bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling intervals (ms)
TOP_GAINERS_INTERVAL=60000        # How often to refresh top gainers list (1 min)
SNAPSHOT_INTERVAL=5000            # How often to compute index snapshot (5 sec)
